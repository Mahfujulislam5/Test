# PostgreSQL database URL (Neon recommended for Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate a long random secret, e.g. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@mirraj.store"
ADMIN_PASSWORD="change-this-before-deploying"

# WhatsApp number in international format, digits only, e.g. 8801XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER="8801XXXXXXXXX"

# Optional store settings
NEXT_PUBLIC_STORE_NAME="MIR RAJ"
